# Скопируйте в .env рядом с этим файлом:
#   copy .env.example .env
# Не коммитьте .env — только этот example.

APP_NAME=SOKOL API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/sokol_db

POSTGRES_DB=sokol_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

SOKOL_LT_URL=
SOKOL_LT_LANG=auto
SOKOL_MAX_UPLOAD_MB=100

SOKOL_CORS_ORIGINS=http://localhost:5180

SOKOL_OLLAMA_URL=http://ollama:11434
SOKOL_OLLAMA_MODEL=qwen2.5:14b
SOKOL_OLLAMA_TIMEOUT_S=600

# MinIO / S3 — замените на свои (ниже — только AWS docs placeholders)
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me

MAIL_PORT=1025
MAIL_USERNAME=support
MAIL_PASSWORD=replace-me

# Скопируйте в .env рядом с этим файлом:
#   copy .env.example .env
# Не коммитьте .env — только этот example.
#
# Переменные ниже читает API (или Postgres в compose).
# MinIO / MailHog / LanguageTool в profile extras — отдельные сервисы;
# приложение к ним не обращается.

APP_NAME=SOKOL API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/sokol_db

POSTGRES_DB=sokol_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

SOKOL_MAX_UPLOAD_MB=100
SOKOL_CORS_ORIGINS=http://localhost:5180

SOKOL_OLLAMA_URL=http://ollama:11434
SOKOL_OLLAMA_MODEL=qwen2.5:14b
SOKOL_OLLAMA_TIMEOUT_S=600

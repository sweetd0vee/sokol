# Скопируйте в .env рядом с этим файлом:
#   copy .env.example .env
# Не коммитьте .env — только этот example.
#
# Переменные ниже читает API (или Postgres / MinIO в compose).

APP_NAME=SOKOL API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/sokol_db

POSTGRES_DB=sokol_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

SOKOL_MAX_UPLOAD_MB=100
# SOKOL_DOCX_MAX_CONCURRENT=2
# SOKOL_DOCX_MAX_QUEUE=8
# SOKOL_DOCX_QUEUE_WAIT_SECONDS=180
SOKOL_CORS_ORIGINS=http://localhost:5180

# Auth (JWT + optional HTTP Basic in development; users in PostgreSQL `users` table)
# SOKOL_ENV=prod — на UAT/prod; требует уникальный SOKOL_JWT_SECRET (>= 32 символов)
SOKOL_ENV=development
SOKOL_JWT_SECRET=sokol-dev-jwt-secret-change-me
SOKOL_JWT_EXPIRE_MINUTES=480
SOKOL_ADMIN_PASSWORD=admin
SOKOL_DEFAULT_USER_PASSWORD=auditor
# SOKOL_ENABLE_BASIC_AUTH=false
# SOKOL_LOAD_DEMO_DATA=0
# SOKOL_SEED_REPLACE=0

# MinIO (object storage для вложений проверок)
SOKOL_MINIO_ENDPOINT=minio:9000
SOKOL_MINIO_ACCESS_KEY=sokol
SOKOL_MINIO_SECRET_KEY=change-me
SOKOL_MINIO_SECURE=0
MINIO_ROOT_USER=sokol
MINIO_ROOT_PASSWORD=change-me

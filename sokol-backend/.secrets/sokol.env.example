# Скопируйте в sokol.env и при необходимости поправьте пути:
#   cp .secrets/sokol.env.example .secrets/sokol.env

APP_NAME=SOKOL API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/sokol_db

SOKOL_MAX_UPLOAD_MB=100
SOKOL_CORS_ORIGINS=http://localhost:5180

# MinIO: для uvicorn на хосте — 127.0.0.1:9000; внутри Docker — minio:9000
SOKOL_MINIO_ENDPOINT=127.0.0.1:9000
SOKOL_MINIO_ACCESS_KEY=sokol
SOKOL_MINIO_SECRET_KEY=change-me
SOKOL_MINIO_SECURE=0

# Auth (dev defaults; на prod: SOKOL_ENV=prod + SOKOL_JWT_SECRET >= 32 символов)
SOKOL_JWT_SECRET=sokol-dev-jwt-secret-change-me
# HTTP Basic выключен в prod по умолчанию; для локальных скриптов: SOKOL_ENABLE_BASIC_AUTH=true
# SOKOL_ENABLE_BASIC_AUTH=false

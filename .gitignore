# --- Secrets / env (never commit real values) ---
.env
.env.*
!.env.example
!**/.env.example
!**/*.env.example
# Dev ports only (no secrets) — useful for clone-and-run
!sokol-frontend/.env.development

# Nested secrets dirs (pattern with / is rooted at this file — use **/ )
**/.secrets/**
!**/.secrets/*.example
!**/.secrets/*.env.example
.secrets/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Node / frontend ---
node_modules/
dist/
build/
.vite/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Logs & OS ---
*.log
logs/
.DS_Store
Thumbs.db

# --- IDE ---
.idea/
.vscode/
*.swp
*~

# --- Local DBs / dumps ---
*.db
*.sqlite
*.sqlite3
*.dump
*.bak

# --- Nested clone metadata ---
**/.git/

# Скопируйте в .env рядом с docker-compose.yml при необходимости:
#   cp .env.example .env

POSTGRES_DB=sokol_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/sokol_db

SOKOL_CORS_ORIGINS=http://localhost:5180
SOKOL_MAX_UPLOAD_MB=100
# SOKOL_ENV=development
# SOKOL_LOAD_DEMO_DATA=1
# DOCX tools queue (optional)
# SOKOL_DOCX_MAX_CONCURRENT=2
# SOKOL_DOCX_MAX_QUEUE=8
# SOKOL_DOCX_QUEUE_WAIT_SECONDS=180

# Auth (internal JWT). Пользователи живут в таблице users (seed), не в env.
SOKOL_JWT_SECRET=sokol-dev-jwt-secret-change-me
SOKOL_JWT_EXPIRE_MINUTES=480
# SOKOL_ADMIN_PASSWORD=admin
# SOKOL_DEFAULT_USER_PASSWORD=auditor

# MinIO (object storage)
MINIO_ROOT_USER=sokol
MINIO_ROOT_PASSWORD=change-me
SOKOL_MINIO_ENDPOINT=minio:9000
SOKOL_MINIO_ACCESS_KEY=sokol
SOKOL_MINIO_SECRET_KEY=change-me
SOKOL_MINIO_SECURE=0

VITE_API_URL=http://localhost:8800

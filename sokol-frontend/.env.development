# Хост/порт dev-сервера Vite (UI). Не используй localhost в браузере — только 127.0.0.1
# (на Windows+WSL localhost→::1 часто даёт ERR_CONNECTION_TIMED_OUT).
VITE_DEV_SERVER_HOST=127.0.0.1
# 5180 занят Docker UI — локальный Vite на 5182
VITE_DEV_SERVER_PORT=5182

# Порт API для прокси /api → backend (8800 = Docker, 8802 = локальный uvicorn)
VITE_DEV_API_PORT=8802
